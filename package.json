{
  "name": "intlayer-vite-svelte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start:editor": "npx intlayer-editor start --with 'vite dev'",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.1.0",
    "intlayer-editor": "9.0.0-canary.12",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "typescript": "6.0.3",
    "vite": "^8.1.3",
    "vite-intlayer": "9.0.0-canary.12"
  },
  "dependencies": {
    "@intlayer/svelte-compiler": "9.0.0-canary.12",
    "intlayer": "9.0.0-canary.12",
    "svelte-intlayer": "9.0.0-canary.12",
    "svelte-spa-router": "^5.1.1"
  }
}
